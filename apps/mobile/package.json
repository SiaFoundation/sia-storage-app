{
  "name": "@siastorage/mobile",
  "version": "1.15.0-rc.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "fresh": "bunx rimraf .expo android ios node_modules && bun install",
    "start": "bun scripts/start.ts",
    "test:native": "bun run test:native:ios && bun run test:native:android",
    "test:native:ios": "bun scripts/nativeTest.ts ios",
    "test:native:android": "bun scripts/nativeTest.ts android",
    "test:native:ios:sim": "bun scripts/nativeTest.ts ios --simulator",
    "dev:ios:simulator": "bun scripts/dev.ts ios:simulator",
    "dev:ios:device": "bun scripts/dev.ts ios:device",
    "dev:android:emulator": "bun scripts/dev.ts android:emulator",
    "dev:android:device": "bun scripts/dev.ts android:device",
    "dev:ios:device:release": "bun scripts/dev.ts ios:device --release",
    "dev:android:device:release": "bun scripts/dev.ts android:device --release",
    "fastlane:ios:build-ipa": "fastlane ios build_ipa",
    "fastlane:android:distribute-play-store": "fastlane android distribute_play_store",
    "fastlane:android:distribute-internal": "fastlane android distribute_internal",
    "fastlane:ios:distribute-app-store": "fastlane ios distribute_app_store",
    "fastlane:ios:distribute-testflight": "fastlane ios distribute_testflight",
    "gradle:signing-report": "bun scripts/androidGradleTask.ts signingReport",
    "gradle:bundle-release": "bun scripts/androidGradleTask.ts bundleRelease",
    "release:android:internal": "bun scripts/releaseAndroid.ts internal",
    "release:android:production": "bun scripts/releaseAndroid.ts production",
    "release:ios:internal": "bun scripts/releaseIos.ts testflight",
    "release:ios:production": "bun scripts/releaseIos.ts appstore",
    "release:beta:android:internal": "APP_VARIANT=beta bun scripts/releaseAndroid.ts internal",
    "release:beta:ios:internal": "APP_VARIANT=beta bun scripts/releaseIos.ts testflight",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:scripts",
    "test:unit": "jest",
    "test:scripts": "bun test scripts/",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "1.0.2",
    "@bacons/text-decoder": "0.0.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@likashefqet/react-native-image-zoom": "4.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@siastorage/core": "workspace:*",
    "@siastorage/logger": "workspace:*",
    "@siastorage/mock-network": "workspace:*",
    "background-time-remaining": "file:./modules/background-time-remaining",
    "expo": "58.0.7",
    "expo-audio": "58.0.8",
    "expo-brightness": "58.0.2",
    "expo-constants": "58.0.10",
    "expo-dev-client": "58.0.12",
    "expo-file-system": "58.0.8",
    "expo-image": "58.0.13",
    "expo-keep-awake": "58.0.3",
    "expo-linear-gradient": "58.0.3",
    "expo-media-library": "58.0.7",
    "expo-screen-orientation": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-share-intent": "8.0.1",
    "expo-sqlite": "58.0.11",
    "expo-updates": "58.0.15",
    "expo-video": "58.0.9",
    "import-sources": "file:./modules/import-sources",
    "lucide-react-native": "1.55.0",
    "markdown-it": "15.0.2",
    "media-observer": "file:./modules/media-observer",
    "memory-info": "file:./modules/memory-info",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.5",
    "react-native-background-fetch": "4.4.2",
    "react-native-background-timer": "2.4.1",
    "react-native-blob-util": "1.0.0",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-get-random-values": "2.0.0",
    "react-native-image-picker": "8.2.1",
    "react-native-inappbrowser-reborn": "3.7.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pdf": "7.0.5",
    "react-native-performance-toolkit": "0.3.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "5.1.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0",
    "react-native-share": "12.3.1",
    "react-native-sia": "0.16.1",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "swr": "2.5.1",
    "thumbnailer": "file:./modules/thumbnailer",
    "upload-service": "file:./modules/upload-service",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/jest-preset": "0.88.0-rc.5",
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-native-background-timer": "2.0.2",
    "babel-jest": "30.5.2",
    "better-sqlite3": "13.0.3",
    "expo-sqlite-mock": "4.0.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.9",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sqlite"
        ]
      }
    }
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
