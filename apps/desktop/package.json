{
  "name": "@siastorage/desktop",
  "version": "0.0.1-rc.3",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun run build/dev.ts",
    "dev:no-mount": "electron-vite dev",
    "build": "electron-vite build",
    "package": "bun run build/package.ts",
    "release": "bun run build/release.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint . && oxfmt --check .",
    "test": "bun test --path-ignore-patterns='**/updates.test.ts' && bun test ./src/main/updates.test.ts"
  },
  "dependencies": {
    "@scure/bip39": "2.4.0",
    "@siastorage/core": "workspace:*",
    "@siastorage/logger": "workspace:*",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
