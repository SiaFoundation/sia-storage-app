# Copy to dev.env and fill in the five blanks from your Apple Developer
# account. dev.env is gitignored: those five are one machine's certificates and
# profiles. Everything below them is the dev identity and is not secret.
#
# `bun run desktop:dev` reads dev.env; it signs and installs on every run because
# an unsigned app gets no Finder folder.
#
# Three contexts, chosen by `bun run desktop:package <context>`:
#
#   dev    Sia Storage Dev    what a source build runs as, signed for this Mac
#   beta   Sia Storage Beta   release candidates
#   prod   Sia Storage        what ships
#
# They carry different bundle ids on purpose, so all three can be installed at
# once without one registering over another's Finder folder.

# Team the App IDs and App Groups live under.
SIA_TEAM_ID=

# Signing identity, as a 40-hex SHA-1 from `security find-identity -v -p codesigning`.
# Apple Development for dev: it runs only on the Macs in the profile.
SIA_SIGN_IDENTITY=

# The File Provider document group. fileproviderd needs one named in the
# extension's Info.plist or it refuses to load the extension at all. Nothing of
# ours is stored there: a sandboxed extension can read an App Group container but
# not write it.
SIA_FILEPROVIDER_GROUP=

# Provisioning profiles, downloaded from the portal. Both are required: the app
# and the extension each carry their own.
SIA_APP_PROFILE=
SIA_EXT_PROFILE=

# The dev identity. A source build with no packaged config falls back to the
# dev values, so a source run and an installed dev build are the same app.
SIA_APP_BUNDLE_ID=sia.storage.desktop.dev
SIA_EXT_BUNDLE_ID=sia.storage.desktop.dev.file-provider

# What Finder shows under Locations, and the domain identifier behind it.
SIA_DOMAIN_ID=sia-dev
SIA_DOMAIN_DISPLAY=Sia Storage Dev
SIA_APP_NAME=Sia Storage Dev
