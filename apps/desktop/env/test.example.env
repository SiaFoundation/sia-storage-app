# Copy to test.env and fill in the five blanks from your Apple Developer
# account. test.env is gitignored: those five are one machine's certificates and
# profiles. Everything below them is the test identity and is not secret. A
# `SIA_*` variable in the shell overrides the same key in test.env.
#
# The test build is what automated device tests install. Its own bundle ids give
# it its own library, socket and Finder folder, so a run never touches the dev
# build someone is using. The team and signing identity are the ones dev.env
# uses. The File Provider group is the test build's own, so no two installed
# extensions name the same document group, and the two profiles are development
# profiles for the two test App IDs below.
#
# Four contexts, chosen by `bun run desktop:package <context>`:
#
#   dev    Sia Storage Dev    what a source build runs as, signed for this Mac
#   test   Sia Storage Test   run by automated device tests, signed here
#   beta   Sia Storage Beta   release candidates
#   prod   Sia Storage        what ships
#
# They carry different bundle ids on purpose, so all four can be installed at
# once without one registering over another's Finder folder.

# Team the App IDs and App Groups live under.
SIA_TEAM_ID=

# Signing identity, as a 40-hex SHA-1 from `security find-identity -v -p codesigning`.
# Apple Development, as for dev: it runs only on the Macs in the profile.
SIA_SIGN_IDENTITY=

# The File Provider document group. fileproviderd needs one named in the
# extension's Info.plist or it refuses to load the extension at all. Nothing of
# ours is stored there: a sandboxed extension can read an App Group container but
# not write it.
SIA_FILEPROVIDER_GROUP=

# Provisioning profiles, downloaded from the portal. Both are required: the app
# and the extension each carry their own.
SIA_APP_PROFILE=
SIA_EXT_PROFILE=

# The test identity.
SIA_APP_BUNDLE_ID=sia.storage.desktop.test
SIA_EXT_BUNDLE_ID=sia.storage.desktop.test.file-provider

# What Finder shows under Locations, and the domain identifier behind it.
SIA_DOMAIN_ID=sia-test
SIA_DOMAIN_DISPLAY=Sia Storage Test
SIA_APP_NAME=Sia Storage Test

# The app's icon, a file in apps/desktop/assets/icons. The test build shares the
# dev build's and is told apart by its name.
SIA_APP_ICON=icon-dev.icns

# Leaves ~/.local/bin/sia pointing where it was. Sim launches the test build and
# nobody runs it as a command, so it must not take over the user's `sia`.
SIA_LINK_CLI=false
